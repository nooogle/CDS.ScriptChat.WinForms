<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Package -->
		<IsPackable>true</IsPackable>
		<Title>CDS ScriptChat WinForms</Title>
		<Description>WinForms script+chat panel for the CDS.ScriptChat library. Host-agnostic: the script buffer is reached through caller-supplied delegates, with no dependency on any specific editor control.</Description>
		<PackageTags>ai;chat;scripting;winforms;claude;llm</PackageTags>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />
		<!-- Shared across both packages. Flaticon licence requires attribution —
		     it lives in readme.md and assets\readme.md. -->
		<None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<!-- DPAPI (System.Security.Cryptography.ProtectedData) ships in the framework for
	     net10.0-windows, so it needs no package reference. -->

	<ItemGroup>
		<!-- Referenced directly rather than relied on transitively: the LoggerMessage source
		     generator ships in this package, and analysers do not flow across a ProjectReference. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
		<!-- MarkdownTextBox for turn rendering — the official, upstream version of the control
		     this project built locally. Depends on Markdig only; no WebView2, no host process, no
		     network access, no file I/O of its own. -->
		<PackageReference Include="CDS.Markdown.Lite" Version="1.5.4-alpha.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CDS.ScriptChat.Core\CDS.ScriptChat.Core.csproj" />
	</ItemGroup>

</Project>
