<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<IsPackable>false</IsPackable>

		<!-- Microsoft.Testing.Platform (MTP) — run with `dotnet run`, not `dotnet test` -->
		<OutputType>Exe</OutputType>
		<EnableMSTestRunner>true</EnableMSTestRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MSTest" Version="4.3.3" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
		<PackageReference Include="AwesomeAssertions" Version="9.5.0" />
		<!-- Drives the real TestHost.exe out-of-process via UI Automation, so these tests see
		     exactly what a user sees — actual painted controls in a real message loop — rather
		     than the in-process control geometry the MSTest suite already covers. -->
		<PackageReference Include="FlaUI.Core" Version="5.0.0" />
		<PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Not referenced by any type here — this just forces the sample's exe and its
		     dependencies to be copied into this project's output directory, so
		     Application.Launch can find them at test time. -->
		<ProjectReference Include="..\..\samples\CDS.ScriptChat.TestHost\CDS.ScriptChat.TestHost.csproj" />
	</ItemGroup>

</Project>
